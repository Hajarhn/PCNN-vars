@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix :     <https://w3id.org/pcnn/> .
@prefix var:  <https://w3id.org/pcnn/var/> .

:coll-inst-brief-pain-inventory a skos:Collection ;
  skos:prefLabel "Brief Pain Inventory"@en ;
  skos:member var:bpi_pain_where_front ,
    var:bpi_prohibited_activity .

:coll-inst-cis20-r a skos:Collection ;
  skos:prefLabel "CIS20-R"@en ;
  skos:member var:cis_18_noenthousiasm ,
    var:cis_13_diff_focus ,
    var:cis_14_phys_bad .

:coll-inst-compass-31 a skos:Collection ;
  skos:prefLabel "COMPASS-31"@en ;
  skos:member var:s31_skin_where ,
    var:c31_dry_mouth ,
    var:c31_drrhea_freq_n ,
    var:c31_bladder_freq_n ,
    var:c31_eyes_change ,
    var:calcc31_eyes_change .

:coll-inst-dsq a skos:Collection ;
  skos:prefLabel "DSQ"@en ;
  skos:member var:dsq_fatigue_freq .

:coll-inst-dsq-2 a skos:Collection ;
  skos:prefLabel "DSQ-2"@en ;
  skos:member var:dsq_slowspeech_sev ,
    var:dsq_muscletwitch_freq ,
    var:dsq_muscletwitch_sev ,
    var:dsq_forgetful_freq ,
    var:dsq_shortbreath_freq ,
    var:dsq_noappetite_freq ,
    var:dsq_slowthink_freq ,
    var:dsq_irregularhb_freq ,
    var:dsq_lowtemp_freq ,
    var:dsq_nightawake_freq ,
    var:dsq_dizzy_freq ,
    var:dsq_hightemp_freq ,
    var:dsq_musclefatigue_sev ,
    var:dsq_pressurepain_freq ,
    var:dsq_achingeyes_freq ,
    var:dsq_headache_freq .

:coll-inst-dsq-pem-dsq-2 a skos:Collection ;
  skos:prefLabel "DSQ-PEM + DSQ-2"@en ;
  skos:member var:dsq_exhausted_freq ,
    var:dsq_pemphysical_freq .

:coll-inst-dsq-pots-dsq-2 a skos:Collection ;
  skos:prefLabel "DSQ-POTS + DSQ-2"@en ;
  skos:member var:dsq_unablestand_freq ,
    var:dsq_blackedvision_freq .

:coll-inst-dsq-sf-dsq-2 a skos:Collection ;
  skos:prefLabel "DSQ-SF + DSQ-2"@en ;
  skos:member var:dsq_memory_freq ,
    var:dsq_pain_freq ,
    var:dsq_bloating_freq ,
    var:dsq_ibs_freq ,
    var:dsq_flu_freq ,
    var:dsq_coldlimbs_freq ,
    var:dsq_sensitivities_freq .

:coll-inst-dsq-sf-dsq-pem-dsq-2 a skos:Collection ;
  skos:prefLabel "DSQ-SF + DSQ-PEM + DSQ-2"@en ;
  skos:member var:dsq_heavy_freq ,
    var:dsq_soreness_freq ,
    var:dsq_minexercise_sev .

