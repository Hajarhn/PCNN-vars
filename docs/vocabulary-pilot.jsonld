    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "iop": "https://w3id.org/iadopt/ont/",
    "pcnn": "https://w3id.org/pcnn/",
    "var": "https://w3id.org/pcnn/var/",
    "vs": "https://w3id.org/pcnn/vs/",
    "prop": "https://w3id.org/pcnn/prop/",
    "cstr": "https://w3id.org/pcnn/constraint/",
    "id": "@id",
    "type": "@type",
    "prefLabel": {"@id": "skos:prefLabel", "@container": "@language"},
    "altLabel": {"@id": "skos:altLabel", "@container": "@language"},
    "definition": {"@id": "skos:definition", "@language": "en"},
    "notation": "skos:notation",
    "inScheme": {"@id": "skos:inScheme", "@type": "@id"},
    "exactMatch": {"@id": "skos:exactMatch", "@type": "@id"},
    "closeMatch": {"@id": "skos:closeMatch", "@type": "@id"},
    "relatedMatch": {"@id": "skos:relatedMatch", "@type": "@id"},
    "related": {"@id": "skos:related", "@type": "@id"},
    "hasProperty": {"@id": "iop:hasProperty", "@type": "@id"},
    "hasObjectOfInterest": {"@id": "iop:hasObjectOfInterest", "@type": "@id"},
    "hasConstraint": {"@id": "iop:hasConstraint", "@type": "@id"}
  },
  "@graph": [
    {
      "id": "pcnn:",
      "type": ["skos:ConceptScheme", "owl:Ontology"],
      "dct:title": {"@language": "en", "@value": "PCNN variable vocabulary"},
      "dct:description": {"@language": "en", "@value": "Pilot release: 5 PCNN codebook columns with SKOS mappings and I-ADOPT decomposition."},
      "dct:creator": {"@id": "https://orcid.org/0000-0001-5262-7399"},
      "dct:created": {"@type": "xsd:date", "@value": "2026-09-08"},
      "dct:modified": {"@type": "xsd:date", "@value": "2026-09-22"},
      "dct:license": {"@id": "https://creativecommons.org/licenses/by/4.0/"},
      "owl:versionInfo": "0.1.0-pilot5"
    },
    {
      "id": "var:HI7",
      "type": ["skos:Concept", "iop:Variable"],
      "inScheme": "pcnn:",
      "notation": "HI7",
      "prefLabel": {"en": "During the past 7 days, I feel fatigued."},
      "definition": "Intensity of feeling fatigued during the past 7 days, PROMIS item HI7.",
      "exactMatch": "http://loinc.org/61878-5",
      "related": "vs:vs-028",
      "hasProperty": "prop:intensity",
      "hasObjectOfInterest": "http://snomed.info/id/84229001",
      "hasConstraint": "cstr:past-7-days"
    },
    {
      "id": "var:FATEXP40",
      "type": ["skos:Concept", "iop:Variable"],
      "inScheme": "pcnn:",
      "notation": "FATEXP40",
      "prefLabel": {"en": "In the past 7 days, how fatigued were you on average?"},
      "definition": "Average intensity of fatigue during the past 7 days, PROMIS item FATEXP40.",
      "exactMatch": "http://loinc.org/61864-5",
      "related": "vs:vs-028",
      "hasProperty": "prop:intensity",
      "hasObjectOfInterest": "http://snomed.info/id/84229001",
      "hasConstraint": "cstr:past-7-days"
    },
    {
      "id": "var:phq_tired",
      "type": ["skos:Concept", "iop:Variable"],
      "inScheme": "pcnn:",
      "notation": "phq_tired",
      "prefLabel": {"en": "Feeling tired or having little energy (last 2 weeks)"},
      "definition": "Frequency of being bothered by tiredness or little energy over the last 2 weeks. PHQ-8 item.",
      "exactMatch": "http://loinc.org/54664-8",
      "related": "vs:vs-017",
      "hasProperty": "prop:frequency",
      "hasObjectOfInterest": "http://snomed.info/id/224960004",
      "hasConstraint": "cstr:past-2-weeks"
    },
    {
      "id": "var:dsq_fatigue_freq",
      "type": ["skos:Concept", "iop:Variable"],
      "inScheme": "pcnn:",
      "notation": "dsq_fatigue_freq",
      "prefLabel": {"en": "Frequency past 6 months: Fatigue / Extreme tiredness"},
      "definition": "Self-reported frequency of fatigue over the past 6 months. DSQ item. Not the same variable as PROMIS HI7.",
      "relatedMatch": "http://snomed.info/id/84229001",
      "related": "vs:vs-002",
      "hasProperty": "prop:frequency",
      "hasObjectOfInterest": "http://snomed.info/id/84229001",
      "hasConstraint": "cstr:past-6-months"
    },
    {
      "id": "var:smokingstatus",
      "type": ["skos:Concept", "iop:Variable"],
      "inScheme": "pcnn:",
      "notation": "smokingstatus",
      "prefLabel": {"en": "Do you smoke?"},
      "definition": "Current tobacco and vape use status, including former smoking. Close to LOINC 72166-2, not identical.",
      "closeMatch": "http://loinc.org/72166-2",
      "related": "vs:vs-051",
      "hasProperty": "prop:status",
      "hasObjectOfInterest": "http://snomed.info/id/365981007"
    }
  ]
}
