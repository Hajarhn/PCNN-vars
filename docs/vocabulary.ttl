: a skos:ConceptScheme ;
  dct:title "PCNN variable vocabulary"@en ;
  dct:description "Local persistent identifiers for PCNN study questionnaire and demographic items. Mappings to LOINC, SNOMED CT or NCIT are annotations, not replacements for the PCNN item IRI."@en ;
  dct:creator "PCNN study team" ;
  dct:created "2026-09-08"^^xsd:date ;
  dct:modified "2026-09-09"^^xsd:date ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:versionInfo "0.1.0" .

vs:smokingstatus-6 a skos:ConceptScheme ;
  dct:title "smokingstatus-6"@en .

<https://w3id.org/pcnn/vs/smokingstatus-6/1> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "1" ;
  skos:prefLabel "No"@en ;
  skos:prefLabel "Nee"@nl .

<https://w3id.org/pcnn/vs/smokingstatus-6/2> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "2" ;
  skos:prefLabel "No, but I have smoked in the past"@en ;
  skos:prefLabel "Nee, maar ik heb in het verleden wel gerookt"@nl .

<https://w3id.org/pcnn/vs/smokingstatus-6/3> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "3" ;
  skos:prefLabel "Yes, occasionally"@en ;
  skos:prefLabel "Ja, af en toe"@nl .

<https://w3id.org/pcnn/vs/smokingstatus-6/4> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "4" ;
  skos:prefLabel "Daily, less than 10 cigarettes/cigars per day"@en ;
  skos:prefLabel "Dagelijks, minder dan 10 sigaretten/sigaren per dag"@nl .

<https://w3id.org/pcnn/vs/smokingstatus-6/5> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "5" ;
  skos:prefLabel "Daily, 10 or more cigarettes/cigars per day"@en ;
  skos:prefLabel "Dagelijks, 10 of meer sigaretten/sigaren per dag"@nl .

<https://w3id.org/pcnn/vs/smokingstatus-6/6> a skos:Concept ;
  skos:inScheme vs:smokingstatus-6 ;
  skos:notation "6" ;
  skos:prefLabel "Daily, e-cigarettes/vapes only"@en ;
  skos:prefLabel "Dagelijks, alleen e-sigaretten/vapes"@nl .

vs:paidjob-4 a skos:ConceptScheme ;
