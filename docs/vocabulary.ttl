var:LTcompl_virus a skos:Concept ;
  skos:inScheme : ;
  skos:notation "LTcompl_virus" ;
  skos:prefLabel "Current long-term health complaints due to the coronavirus"@en ;
  skos:prefLabel "Huidige langdurige gezondheidsklachten door het coronavirus"@nl ;
  skos:definition "Whether the respondent currently has long-term health complaints attributed to the coronavirus."@en ;
  skos:relatedMatch <http://snomed.info/id/1119304009> ;
  skos:related vs:yes-no-recovered .

var:LTcompl_virus_start a skos:Concept ;
  skos:inScheme : ;
  skos:notation "LTcompl_virus_start" ;
  skos:prefLabel "Approximate start date of coronavirus-related long-term complaints"@en ;
  skos:prefLabel "Geschatte startdatum van coronavirusgerelateerde langdurige klachten"@nl ;
  skos:definition "Estimated start date of long-term complaints attributed to the coronavirus."@en ;
  skos:relatedMatch <http://snomed.info/id/298059007> .

var:LTcompl_virus_recover a skos:Concept ;
  skos:inScheme : ;
  skos:notation "LTcompl_virus_recover" ;
  skos:prefLabel "Approximate recovery date from coronavirus-related long-term complaints"@en ;
  skos:prefLabel "Geschatte hersteldatum van coronavirusgerelateerde langdurige klachten"@nl ;
  skos:definition "Estimated date of recovery from long-term complaints attributed to the coronavirus."@en .

var:LTcompl_vacc a skos:Concept ;
  skos:inScheme : ;
  skos:notation "LTcompl_vacc" ;
  skos:prefLabel "Current long-term health complaints due to a coronavirus vaccination"@en ;
  skos:prefLabel "Huidige langdurige gezondheidsklachten door een coronavirusvaccinatie"@nl ;
  skos:definition "Whether the respondent currently has long-term health complaints attributed to a coronavirus vaccination."@en ;
  skos:relatedMatch <http://snomed.info/id/293104008> ;
  skos:related vs:yes-no-recovered .

var:LTcompl_vacc_recover a skos:Concept ;
  skos:inScheme : ;
  skos:notation "LTcompl_vacc_recover" ;
  skos:prefLabel "Approximate recovery date from vaccine-related long-term complaints"@en ;
  skos:prefLabel "Geschatte hersteldatum van vaccingerelateerde langdurige klachten"@nl ;
  skos:definition "Estimated date of recovery from long-term complaints attributed to the coronavirus vaccine."@en ;
  skos:relatedMatch <http://snomed.info/id/293104008> .

var:depression_history a skos:Concept ;
  skos:inScheme : ;
  skos:notation "depression_history" ;
  skos:prefLabel "Have you ever suffered from depressive symptoms?"@en ;
  skos:prefLabel "Heb je ooit last gehad van depressieve klachten?"@nl ;
  skos:definition "Lifetime history of depressive symptoms, with optional year of last episode."@en ;
  skos:relatedMatch <http://snomed.info/id/394924000> ;
  skos:related vs:depression-history .

var:s31_skin_where a skos:Concept ;
  skos:inScheme : ;
  skos:notation "s31_skin_where" ;
  skos:prefLabel "Which body parts are affected by these colour changes?"@en ;
  skos:prefLabel "Welke lichaamsdelen zijn betrokken bij deze kleurveranderingen?"@nl ;
  skos:definition "COMPASS-31 item: body regions affected by skin colour changes."@en ;
  skos:relatedMatch <http://snomed.info/id/364533002> ;
  skos:related vs:s31-skin-2 .

var:c31_dry_mouth a skos:Concept ;
  skos:inScheme : ;
  skos:notation "c31_dry_mouth" ;
  skos:prefLabel "Does your mouth feel abnormally dry?"@en ;
  skos:prefLabel "Voelt uw mond abnormaal droog aan?"@nl ;
  skos:definition "COMPASS-31 item asking whether the mouth feels abnormally dry."@en ;
  skos:closeMatch <http://loinc.org/63981-5> ;
  skos:related vs:c31-dry-mouth .

var:c31_drrhea_freq_n a skos:Concept ;
  skos:inScheme : ;
  skos:notation "c31_drrhea_freq_n" ;
  skos:prefLabel "How many times per month? (diarrhea)"@en ;
  skos:prefLabel "Hoe vaak per maand? (diarree)"@nl ;
  skos:definition "COMPASS-31 count of diarrhea episodes per month."@en ;
  skos:relatedMatch <http://loinc.org/69711-0> .

var:c31_bladder_freq_n a skos:Concept ;
  skos:inScheme : ;
  skos:notation "c31_bladder_freq_n" ;
  skos:prefLabel "How many times per month? (bladder)"@en ;
  skos:prefLabel "Hoe vaak per maand? (blaas)"@nl ;
  skos:definition "COMPASS-31 count of bladder-related episodes per month."@en .

var:c31_eyes_change a skos:Concept ;
  skos:inScheme : ;
  skos:notation "c31_eyes_change" ;
  skos:prefLabel "This most annoying eye complaint is"@en ;
  skos:prefLabel "Deze meest hinderlijke oogklacht is"@nl ;
  skos:definition "COMPASS-31 item identifying the most annoying eye complaint."@en .

var:calcc31_eyes_change a skos:Concept ;
  skos:inScheme : ;
  skos:notation "calcc31_eyes_change" ;
  skos:prefLabel "COMPASS dependency (eyes)"@en ;
  skos:prefLabel "COMPASS-afhankelijkheid (ogen)"@nl ;
  skos:definition "Derived COMPASS-31 eyes-change dependency score calculated by the study pipeline."@en .

var:permission a skos:Concept ;
  skos:inScheme : ;
  skos:notation "permission" ;
  skos:prefLabel "May we contact you for additional scientific research?"@en ;
  skos:prefLabel "Mogen we je benaderen voor aanvullend wetenschappelijk onderzoek?"@nl ;
  skos:definition "Consent to be approached for additional PCNN scientific research."@en ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C125453> ;
  skos:related vs:permission-2 .

var:permission_pc a skos:Concept ;
  skos:inScheme : ;
  skos:notation "permission_pc" ;
  skos:prefLabel "Consent form for post-COVID research"@en ;
  skos:prefLabel "Toestemmingsformulier voor post-COVID-onderzoek"@nl ;
  skos:definition "Record that the post-COVID research consent form was presented or completed."@en ;
  skos:relatedMatch <http://snomed.info/id/75554001> .

var:persmission_postvacc a skos:Concept ;
  skos:inScheme : ;
  skos:notation "persmission_postvacc" ;
  skos:prefLabel "Consent form for post-COVID vaccination complaints research"@en ;
  skos:prefLabel "Toestemmingsformulier voor onderzoek naar post-COVID-vaccinatieklachten"@nl ;
  skos:definition "Record that the post-vaccination complaints consent form was presented or completed. Column name keeps the original codebook spelling."@en ;
  skos:relatedMatch <http://snomed.info/id/75554001> .

var:permissions_check a skos:Concept ;
  skos:inScheme : ;
  skos:notation "permissions_check" ;
  skos:prefLabel "Confirmation that additional-research permission was not given"@en ;
  skos:prefLabel "Je hebt op de vorige pagina (nog) geen toestemming gegeven om benaderd te mogen worden voor aanvullend onderzoek. Klopt dit?"@nl ;
  skos:definition "Check item confirming that the respondent did not give permission to be approached for additional research."@en ;
  skos:related vs:permissions-check .

var:travel a skos:Concept ;
  skos:inScheme : ;
  skos:notation "travel" ;
  skos:prefLabel "Able and willing to travel for additional research"@en ;
  skos:prefLabel "Ben je in staat en bereid om te reizen om deel te nemen aan aanvullend onderzoek?"@nl ;
  skos:definition "Whether the respondent can travel to take part in additional research."@en ;
  skos:related vs:travel-3 .

var:contact a skos:Concept ;
  skos:inScheme : ;
  skos:notation "contact" ;
  skos:prefLabel "May we contact you for a telephone or video appointment?"@en ;
  skos:prefLabel "Mogen we je benaderen voor een belafspraak of een videogesprek voor aanvullend onderzoek"@nl ;
  skos:definition "Consent to be contacted by phone or video for additional research."@en ;
  skos:related vs:yes-no .

