var:funcap_usetoilet a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_usetoilet" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Using the toilet (not bedpan or bedside commode)"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Naar het toilet gaan (geen ondersteek of postoel naast het bed)."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C131919> ;
  skos:related vs:vs-003 .

var:funcap_shower a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_shower" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Showering standing up"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Staand douchen."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224920> ;
  skos:related vs:vs-003 .

var:funcap_clothing a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_clothing" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Getting dressed in regular clothes"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Gewone kleding aantrekken."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224921> ;
  skos:related vs:vs-003 .

var:funcap_walkindoor a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_walkindoor" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Walking a short distance indoors, from one room to another"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Een kort stukje lopen in huis, van de ene kamer naar de andere."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C121233> ;
  skos:related vs:vs-003 .

var:funcap_walkingdistance a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_walkingdistance" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Walking between approx. 100 m and 1 km on level ground"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Tussen de 100 m en 1 km lopen op vlak terrein (de lengte van 1 tot 10 voetbalvelden)."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224922> ;
  skos:related vs:vs-003 .

var:funcap_activity a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_activity" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Physical activity with increased heart rate, for approx. 15 min"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Lichamelijke activiteit met verhoogde hartslag, ongeveer 15 minuten."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224923> ;
  skos:related vs:vs-003 .

var:funcap_sitbed a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_sitbed" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Sitting in bed for approx. half an hour"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Zitten in bed, ongeveer een half uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224924> ;
  skos:related vs:vs-003 .

var:funcap_sitchair a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_sitchair" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Sitting in an upright chair with feet on floor for approx. 2 hours"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Zitten op een stoel (zoals een eetkamerstoel) met de voeten op de grond, ongeveer 2 uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224925> ;
  skos:related vs:vs-003 .

var:funcap_standing a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_standing" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Standing up for approx. 5 minutes, e.g. while queuing or while cooking"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Staan, ongeveer 5 minuten (bijvoorbeeld in de rij of tijdens het koken)."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224926> ;
  skos:related vs:vs-003 .

var:funcap_heavywork a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_heavywork" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Heavier housework (washing floors, vacuuming etc.) for approx. half an hour continuously"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Zwaarder huishoudelijk werk (dweilen, stofzuigen, enz.), ongeveer een half uur zonder te stoppen."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C121223> ;
  skos:related vs:vs-003 .

var:funcap_cooking a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_cooking" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Cooking a complicated meal from scratch, approx. 1 hour"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Een ingewikkelde maaltijd koken, waarbij u alle ingredienten zelf snijdt en bereidt, 1 uur actief bezig zijn."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224927> ;
  skos:related vs:vs-003 .

var:funcap_conversationshort a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_conversationshort" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Having a conversation for approx. 5 minutes"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Een gesprek voeren van ongeveer 5 minuten."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224928> ;
  skos:related vs:vs-003 .

var:funcap_conversation30min a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_conversation30min" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Participating in a conversation with three people for approx. half an hour"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Een gesprek voeren met z'n drieën, ongeveer een half uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224929> ;
  skos:related vs:vs-003 .

var:funcap_social a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_social" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Participating in a dinner party, party or family event"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Deelnemen aan een diner, feest of familiebijeenkomst."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224930> ;
  skos:related vs:vs-003 .

var:funcap_outside a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_outside" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Stepping right outside your home"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Even kort uw voordeur uit lopen."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224931> ;
  skos:related vs:vs-003 .

var:funcap_shopping a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_shopping" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Going to a shop for groceries"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Boodschappen doen in een winkel."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224933> ;
  skos:related vs:vs-003 .

var:funcap_transport a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_transport" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Using public transport (bus or train)"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Met het openbaar vervoer gaan (bijvoorbeeld bus of trein)."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224934> ;
  skos:related vs:vs-003 .

var:funcap_participateactivity a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_participateactivity" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Participating in organized leisure activities such as classes or sports"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Deelnemen aan georganiseerde activiteiten zoals groepslessen, sport, enz. (voor uw plezier)."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224932> ;
  skos:related vs:vs-003 .

var:funcap_lighting a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_lighting" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Staying in a room with normal lighting without sunglasses for approx. 1 hour"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  In een kamer met normale verlichting zijn, zonder zonnebril op, ongeveer 1 uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224935> ;
  skos:related vs:vs-003 .

var:funcap_sunglasses a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_sunglasses" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Staying outdoors in daylight without sunglasses for approx. 2 hours"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  Buiten in het daglicht zijn, zonder zonnebril op, ongeveer 2 uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224936> ;
  skos:related vs:vs-003 .

var:funcap_noise a skos:Concept ;
  skos:inScheme : ;
  skos:notation "funcap_noise" ;
  skos:prefLabel "What are the consequences for you if you perform the activities described below? To what extent does this affect how much else you can do?  Staying in a noisy environment for approx. 1 hour"@en ;
  skos:prefLabel "Wat zijn de gevolgen voor u als u de hieronder beschreven activiteiten uitvoert? Hoeveel invloed heeft dit op wat u verder nog kunt doen?  In een lawaaiige omgeving zijn (winkelcentrum, café of kantoortuin), ongeveer 1 uur."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C224937> ;
  skos:related vs:vs-003 .

