vs:vs-101 a skos:ConceptScheme ;
  dct:title "vs-101"@en .

<https://w3id.org/pcnn/vs/vs-101/100> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "100" ;
  skos:prefLabel "No symptoms at rest; no symptoms with exercise; normal overall activity level; able to work full-time without difficulty."@en .

<https://w3id.org/pcnn/vs/vs-101/90> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "90" ;
  skos:prefLabel "No symptoms at rest; mild symptoms with activity; normal overall activity level; able to work full-time without difficulty."@en .

<https://w3id.org/pcnn/vs/vs-101/80> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "80" ;
  skos:prefLabel "Mild symptoms at rest; symptoms worsened by exertion; minimal activity restriction noted for activities requiring exertion only; able to work full-time with difficulty in jobs requiring exertion."@en .

<https://w3id.org/pcnn/vs/vs-101/70> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "70" ;
  skos:prefLabel "Mild symptoms at rest; some daily activity limitation clearly noted. Overall functioning close to 90% of expected except for activities requiring exertion. Able to work full-time with difficulty."@en .

<https://w3id.org/pcnn/vs/vs-101/60> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "60" ;
  skos:prefLabel "Mild to moderate symptoms at rest; daily activity limitation clearly noted. Overall functioning 70%-90%. Unable to work full-time in jobs requiring physical labor, but able to work full-time in light activity if hours flexible."@en .

<https://w3id.org/pcnn/vs/vs-101/50> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "50" ;
  skos:prefLabel "Moderate symptoms at rest. Moderate to severe symptoms with exercise or activity; overall activity level reduced to 70% of expected. Unable to perform strenuous duties, but able to perform light duty or desk work 4-5 hours a day, but requires rest periods."@en .

<https://w3id.org/pcnn/vs/vs-101/40> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "40" ;
  skos:prefLabel "Moderate symptoms at rest. Moderate to severe symptoms with exercise or activity; overall activity level reduced to 50%-70% of expected. Not confined to house. Unable to perform strenuous duties; able to perform light duty or desk work 3-4 hours a day, but requires rest periods."@en .

<https://w3id.org/pcnn/vs/vs-101/30> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "30" ;
  skos:prefLabel "Moderate to severe symptoms at rest. Severe symptoms with any exercise; overall activity level reduced to 50% of expected. Usually confined to house. Unable to perform any strenuous tasks. Able to perform desk work 2-3 hours a day, but requires rest periods."@en .

<https://w3id.org/pcnn/vs/vs-101/20> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "20" ;
  skos:prefLabel "Moderate to severe symptoms at rest. Unable to perform strenuous activity; overall activity 30%-50% of expected. Unable to leave house except rarely; confined to bed most of day; unable to concentrate for more than 1 hour a day."@en .

<https://w3id.org/pcnn/vs/vs-101/10> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "10" ;
  skos:prefLabel "Severe symptoms at rest; bedridden the majority of the time. No travel outside of the house. Marked cognitive symptoms preventing concentration."@en .

<https://w3id.org/pcnn/vs/vs-101/0> a skos:Concept ;
  skos:inScheme vs:vs-101 ;
  skos:notation "0" ;
  skos:prefLabel "Severe symptoms on a continuous basis; bedridden constantly; unable to care for self."@en .

