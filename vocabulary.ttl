var:sf36_01 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_01" ;
  skos:prefLabel "In general, would you say your health is?"@en ;
  skos:prefLabel "Wat vindt u, over het algemeen genomen, van uw gezondheid?"@nl ;
  skos:closeMatch <http://loinc.org/71933-6> ;
  skos:related vs:vs-084 .

var:sf36_02 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_02" ;
  skos:prefLabel "Compared to one year ago, how would you rate your health in general now?"@en ;
  skos:prefLabel "In vergelijking met een jaar geleden, hoe zou u nu uw gezondheid in het algemeen beoordelen?"@nl ;
  skos:closeMatch <http://loinc.org/61577-3> ;
  skos:related vs:vs-085 .

var:sf36_03a a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03a" ;
  skos:prefLabel "Does your health now limit you in vigorous activities, such as running, lifting heavy objects, participating in strenuous sports?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij  forse inspanning zoals hardlopen, zware voorwerpen tillen, inspannend sporten?"@nl ;
  skos:closeMatch <http://loinc.org/71932-8> ;
  skos:related vs:vs-010 .

var:sf36_03b a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03b" ;
  skos:prefLabel "Does your health now limit you in moderate activities, such as moving a table, pushing a vacuum cleaner, bowling, or playing golf?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij  matige inspanning zoals het verplaatsen van een tafel, stofzuigen, fietsen?"@nl ;
  skos:closeMatch <http://loinc.org/71931-0> ;
  skos:related vs:vs-010 .

var:sf36_03c a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03c" ;
  skos:prefLabel "Does your health now limit you in lifting or carrying groceries?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij  tillen of boodschappen dragen?"@nl ;
  skos:closeMatch <http://loinc.org/71930-2> ;
  skos:related vs:vs-010 .

var:sf36_03d a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03d" ;
  skos:prefLabel "Does your health now limit you in climbing several flights of stairs?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij  een paar trappen oplopen?"@nl ;
  skos:closeMatch <http://loinc.org/71928-6> ;
  skos:related vs:vs-010 .

var:sf36_03e a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03e" ;
  skos:prefLabel "Does your health now limit you in climbing one flight of stairs?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij één trap oplopen?"@nl ;
  skos:closeMatch <http://loinc.org/71929-4> ;
  skos:related vs:vs-010 .

var:sf36_03f a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03f" ;
  skos:prefLabel "Does your health now limit you in bending, kneeling, or stooping?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij  buigen, knielen of bukken?"@nl ;
  skos:closeMatch <http://loinc.org/71927-8> ;
  skos:related vs:vs-010 .

var:sf36_03g a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03g" ;
