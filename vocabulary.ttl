vs:vs-003 a skos:ConceptScheme ;
  dct:title "vs-003"@en .

<https://w3id.org/pcnn/vs/vs-003/0> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "0" ;
  skos:prefLabel "I cannot do this"@en .

<https://w3id.org/pcnn/vs/vs-003/1> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "1" ;
  skos:prefLabel "My capacity will be severely reduced for at least three days"@en .

<https://w3id.org/pcnn/vs/vs-003/2> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "2" ;
  skos:prefLabel "I can do little else on the same day and for one to two days afterwards"@en .

<https://w3id.org/pcnn/vs/vs-003/3> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "3" ;
  skos:prefLabel "I can do little else on the same day"@en .

<https://w3id.org/pcnn/vs/vs-003/4> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "4" ;
  skos:prefLabel "I must limit other activities on the same day"@en .

<https://w3id.org/pcnn/vs/vs-003/5> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "5" ;
  skos:prefLabel "This rarely affects other activities"@en .

<https://w3id.org/pcnn/vs/vs-003/6> a skos:Concept ;
  skos:inScheme vs:vs-003 ;
  skos:notation "6" ;
  skos:prefLabel "Unproblematic – does not affect other activities"@en .

