  skos:notation "PAININ34" ;
  skos:prefLabel "In the past 7 days, how much did pain interfere with your household chores?"@en ;
  skos:prefLabel "In de afgelopen 7 dagen, in welke mate belemmerde de pijn u bij uw huishoudelijke klusjes?"@nl ;
  skos:exactMatch <http://loinc.org/61775-3> ;
  skos:related vs:vs-029 .

var:Global07 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "Global07" ;
  skos:prefLabel "In the past 7 days, how would you rate your pain  on average? (0 = no pain, 10 = worst pain imaginable)"@en ;
  skos:prefLabel "In de afgelopen 7 dagen, hoe zou u gemiddeld uw pijn beoordelen?"@nl ;
  skos:exactMatch <http://loinc.org/61583-1> ;
  skos:related vs:vs-100 .

var:PC2r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC2r" ;
  skos:prefLabel "My thinking has been slow…"@en ;
  skos:prefLabel "De afgelopen 7 dagen verliep mijn denkproces traag."@nl ;
  skos:exactMatch <http://loinc.org/81461-6> ;
  skos:related vs:vs-019 .

var:PC35r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC35r" ;
  skos:prefLabel "In the past 7 days, it has seemed like my brain was not working as well as usual…"@en ;
  skos:prefLabel "De afgelopen 7 dagen leek het alsof mijn hersenen niet zo goed werkten als gewoonlijk."@nl ;
  skos:exactMatch <http://loinc.org/81478-0> ;
  skos:related vs:vs-019 .

var:PC36r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC36r" ;
  skos:prefLabel "In the past 7 days, I have had to work harder than usual to keep track of what I was doing…"@en ;
  skos:prefLabel "De afgelopen 7 dagen heb ik me méér moeten inspannen dan gewoonlijk om bij te houden wat ik aan het doen was."@nl ;
  skos:exactMatch <http://loinc.org/81479-8> ;
  skos:related vs:vs-019 .

var:PC42r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC42r" ;
  skos:prefLabel "In the past 7 days, I have had trouble shifting back and forth between different activities that require thinking…"@en ;
  skos:prefLabel "De afgelopen 7 dagen had ik moeite om heen en weer te schakelen tussen verschillende activiteiten waarbij ik moest nadenken."@nl ;
  skos:exactMatch <http://loinc.org/81485-5> ;
  skos:related vs:vs-019 .

var:PC8r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC8r" ;
  skos:prefLabel "In the past 7 days, I have had trouble concentrating…"@en ;
  skos:prefLabel "De afgelopen 7 dagen had ik moeite om me te concentreren."@nl ;
  skos:exactMatch <http://loinc.org/81465-7> ;
  skos:related vs:vs-019 .

var:PC25r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC25r" ;
  skos:prefLabel "In the past 7 days, I have had to work really hard to pay attention or I would make a mistake…"@en ;
  skos:prefLabel "De afgelopen 7 dagen moest ik me echt heel hard inspannen om op te letten, anders zou ik een fout maken."@nl ;
  skos:exactMatch <http://loinc.org/81474-9> ;
  skos:related vs:vs-019 .

var:PC1r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC1r" ;
  skos:prefLabel "In the past 7 days, I have had trouble forming thoughts..."@en ;
  skos:prefLabel "De afgelopen 7 dagen had ik moeite om mijn gedachten te vormen."@nl ;
  skos:exactMatch <http://loinc.org/81460-8> ;
  skos:related vs:vs-019 .

var:PC5r a skos:Concept ;
  skos:inScheme : ;
  skos:notation "PC5r" ;
  skos:prefLabel "In the past 7 days, I have had trouble adding or subtracting numbers in my head …"@en ;
  skos:prefLabel "De afgelopen 7 dagen had ik moeite met het optellen en aftrekken van getallen in mijn hoofd."@nl ;
  skos:exactMatch <http://loinc.org/81463-2> ;
  skos:related vs:vs-019 .

var:FSS_motivation a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_motivation" ;
  skos:prefLabel "My motivation is lower when I am fatigued."@en ;
  skos:prefLabel "Als ik moe ben, ben ik minder gemotiveerd."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113944> ;
  skos:related vs:vs-014 .

var:FSS_exercise a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_exercise" ;
  skos:prefLabel "Exercise brings on my fatigue."@en ;
  skos:prefLabel "Mijn vermoeidheid wordt opgeroepen door lichaamsbeweging."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113945> ;
  skos:related vs:vs-014 .

var:FSS_easily a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_easily" ;
  skos:prefLabel "I am easily fatigued."@en ;
  skos:prefLabel "Ik ben snel vermoeid."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113946> ;
  skos:related vs:vs-014 .

var:FSS_physfunc a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_physfunc" ;
  skos:prefLabel "Fatigue interferes with my physical functioning."@en ;
  skos:prefLabel "Moeheid belemmert mijn lichamelijk functioneren"@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113947> ;
  skos:related vs:vs-014 .

var:FSS_problems a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_problems" ;
  skos:prefLabel "Fatigue causes frequent problems for me."@en ;
  skos:prefLabel "Mijn moeheid zorgt vaak voor problemen."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113948> ;
  skos:related vs:vs-014 .

var:FSS_sustained a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_sustained" ;
  skos:prefLabel "My fatigue prevents sustained physical functioning."@en ;
  skos:prefLabel "Langdurig lichamelijk inspannen kan ik niet door de vermoeidheid."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113949> ;
  skos:related vs:vs-014 .

var:FSS_duties a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_duties" ;
  skos:prefLabel "Fatigue interferes with carrying out certain duties and responsibilities."@en ;
  skos:prefLabel "Moeheid belemmert mij bij het uitvoeren van bepaalde taken en verantwoordelijkheden."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113950> ;
  skos:related vs:vs-014 .

var:FSS_disabling a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_disabling" ;
  skos:prefLabel "Fatigue is among my three most disabling symptoms."@en ;
  skos:prefLabel "Van de klachten die mij het meest hinderen, is vermoeidheid één van de drie ergste."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113951> ;
  skos:related vs:vs-014 .

var:FSS_life a skos:Concept ;
  skos:inScheme : ;
  skos:notation "FSS_life" ;
  skos:prefLabel "Fatigue interferes with my work, family, or social life."@en ;
  skos:prefLabel "Bij mijn werk, gezinsleven of sociale contacten word ik belemmerd door mijn vermoeidheid."@nl ;
  skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C113952> ;
  skos:related vs:vs-014 .

var:BellScore a skos:Concept ;
  skos:inScheme : ;
  skos:notation "BellScore" ;
  skos:prefLabel "Circle the number of the statement that best describes your level of physical function"@en ;
  skos:prefLabel "Omcirkel het nummer van de uitspraak die het beste uw niveau van fysieke functie beschrijft"@nl ;
  skos:relatedMatch <http://snomed.info/id/718736009> ;
  skos:related vs:vs-101 .

