var:sf36_09e a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09e" ;
  skos:prefLabel "How much of the time during the past 4 weeks did you have a lot of energy?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich erg energiek de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71908-8> ;
  skos:related vs:vs-012 .

var:sf36_09f a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09f" ;
  skos:prefLabel "How much of the time during the past 4 weeks have you felt downhearted and blue?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich neerslachtig en somber de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71907-0> ;
  skos:related vs:vs-012 .

var:sf36_09g a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09g" ;
  skos:prefLabel "How much of the time during the past 4 weeks did you feel worn out?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich uitgeblust de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71906-2> ;
  skos:related vs:vs-012 .

var:sf36_09h a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09h" ;
  skos:prefLabel "How much of the time during the past 4 weeks have you been a happy person?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich gelukkig de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71905-4> ;
  skos:related vs:vs-012 .

var:sf36_09i a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09i" ;
  skos:prefLabel "How much of the time during the past 4 weeks did you feel tired?"@en ;
  skos:prefLabel "Hoe vaak heeft u voelde u zich moe de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71904-7> ;
  skos:related vs:vs-012 .

var:sf36_10 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_10" ;
  skos:prefLabel "During the past 4 weeks, how much of the time has your physical health or emotional problems interfered with your social activities (like visiting with friends, relatives, etc.)?"@en ;
  skos:prefLabel "Hoe vaak hebben uw lichamelijke gezondheid of emotionele problemen gedurende de afgelopen 4 weken uw sociale activiteiten (zoals bezoek aan vrienden of naaste familieleden) belemmerd?"@nl ;
  skos:closeMatch <http://loinc.org/71903-9> ;
