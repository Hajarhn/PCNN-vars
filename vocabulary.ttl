  skos:inScheme : ;
  skos:notation "sf36_03h" ;
  skos:prefLabel "Does your health now limit you in walking several blocks?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij een halve kilometer lopen?"@nl ;
  skos:closeMatch <http://loinc.org/71925-2> ;
  skos:related vs:vs-010 .

var:sf36_03i a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03i" ;
  skos:prefLabel "Does your health now limit you in walking one block?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij honderd meter lopen?"@nl ;
  skos:closeMatch <http://loinc.org/71924-5> ;
  skos:related vs:vs-010 .

var:sf36_03j a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_03j" ;
  skos:prefLabel "Does your health now limit you in bathing or dressing yourself?"@en ;
  skos:prefLabel "Wordt u door uw gezondheid op dit moment beperkt bij uzelf wassen of aankleden?"@nl ;
  skos:closeMatch <http://loinc.org/71923-7> ;
  skos:related vs:vs-010 .

var:sf36_04a a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_04a" ;
  skos:prefLabel "During the past 4 weeks, as a result of your physical health, did you cut down the amount of time you spent on work or other activities?"@en ;
  skos:prefLabel "Had u, ten gevolge van lichamelijke genzondheid, de afgelopen vier weken, u heeft minder tijd kunnen besteden aan werk of andere bezigheden?"@nl ;
  skos:closeMatch <http://loinc.org/71918-7> ;
  skos:related vs:vs-020 .

var:sf36_04b a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_04b" ;
  skos:prefLabel "During the past 4 weeks, as a result of your physical health, did you accomplished less than you would like?"@en ;
  skos:prefLabel "Had u, ten gevolge van lichamelijke genzondheid, de afgelopen vier weken, u heeft minder bereikt dan u zou willen?"@nl ;
  skos:closeMatch <http://loinc.org/71917-9> ;
  skos:related vs:vs-020 .

var:sf36_04c a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_04c" ;
  skos:prefLabel "During the past 4 weeks, as a result of your physical health, were you limited in the kind of work or other activities?"@en ;
  skos:prefLabel "Was u, ten gevolge van lichamelijke genzondheid, de afgelopen vier weken, beperkt in het soort werk of het soort bezigheden?"@nl ;
  skos:closeMatch <http://loinc.org/71920-3> ;
  skos:related vs:vs-020 .

var:sf36_04d a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_04d" ;
  skos:prefLabel "During the past 4 weeks, as a result of your physical health, did you have difficulty performing the work or other activities (for example, it took extra effort)?"@en ;
  skos:prefLabel "Had u, ten gevolge van lichamelijke gezondheid, de afgelopen vier weken, moeite met het werk of andere bezigheden (het kostte u bijvoorbeeld extra inspanning)?"@nl ;
  skos:closeMatch <http://loinc.org/71919-5> ;
  skos:related vs:vs-020 .

var:sf36_05a a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_05a" ;
  skos:prefLabel "During the past 4 weeks, as a result of any emotional problems (such as feeling depressed or anxious), did you cut down the amount of time you spent on work or other activities?"@en ;
  skos:prefLabel "Had u, ten gevolge van een emotioneel probleem (bijvoorbeeld doordat u zich depressief of angstig voelde), de afgelopen vier weken,  minder tijd kunnen besteden aan werk of andere bezigheden?"@nl ;
  skos:closeMatch <http://loinc.org/71918-7> ;
  skos:related vs:vs-020 .

var:sf36_05b a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_05b" ;
  skos:prefLabel "During the past 4 weeks, as a result of any emotional problems (such as feeling depressed or anxious), did you cut down the amount of time you spent on work or other activities?"@en ;
  skos:prefLabel "Had u, ten gevolge van een emotioneel probleem (bijvoorbeeld doordat u zich depressief of angstig voelde), de afgelopen vier weken,  minder bereikt dan u zou willen?"@nl ;
  skos:closeMatch <http://loinc.org/71917-9> ;
  skos:related vs:vs-020 .

var:sf36_05c a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_05c" ;
  skos:prefLabel "During the past 4 weeks, as a result of any emotional problems (such as feeling depressed or anxious), did you ccomplished less than you would like?"@en ;
  skos:prefLabel "Had u, ten gevolge van een emotioneel probleem (bijvoorbeeld doordat u zich depressief of angstig voelde), de afgelopen vier weken, het werk of andere bezigheden niet zo zorgvuldig gedaan als u gewend bent?"@nl ;
  skos:closeMatch <http://loinc.org/71916-1> ;
  skos:related vs:vs-020 .

var:sf36_06 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_06" ;
  skos:prefLabel "During the past 4 weeks, to what extent has your physical health or emotional problems interfered with your normal social activities with family, friends, neighbors, or groups?"@en ;
  skos:prefLabel "In hoeverre heeft uw lichamelijke gezondheid of hebben uw emotionele problemen u de afgelopen 4 weken belemmerd in uw normale sociale bezigheden met gezin, vrienden, buren of anderen?"@nl ;
  skos:closeMatch <http://loinc.org/71903-9> ;
  skos:related vs:vs-039 .

var:sf36_07 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_07" ;
  skos:prefLabel "How much bodily pain have you had during the past 4 weeks?"@en ;
  skos:prefLabel "Hoeveel pijn had u de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71914-6> ;
  skos:related vs:vs-086 .

var:sf36_08 a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_08" ;
  skos:prefLabel "During the past 4 weeks, how much did pain interfere with your normal work (including both work outside the home and housework)?"@en ;
  skos:prefLabel "In welke mate heeft pijn u de afgelopen vier weken belemmerd bij uw normale werkzaamheden (zowel werk buitenshuis als huishoudelijk werk)?"@nl ;
  skos:closeMatch <http://loinc.org/71913-8> ;
  skos:related vs:vs-039 .

var:sf36_09a a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09a" ;
  skos:prefLabel "How much of the time during the past 4 weeks did you feel full of pep?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich levenslustig de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71912-0> ;
  skos:related vs:vs-012 .

var:sf36_09b a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09b" ;
  skos:prefLabel "How much of the time during the past 4 weeks have you been a nervous person?"@en ;
  skos:prefLabel "Hoe vaak voelde u zich erg zenuwachtig de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71911-2> ;
  skos:related vs:vs-012 .

var:sf36_09c a skos:Concept ;
  skos:inScheme : ;
  skos:notation "sf36_09c" ;
  skos:prefLabel "How much of the time during the past 4 weeks have you felt so down in the dumps that nothing could cheer your up?"@en ;
  skos:prefLabel "Hoe vaak zat u zo erg in de put dat niets u kon opvrolijken de afgelopen 4 weken?"@nl ;
  skos:closeMatch <http://loinc.org/71910-4> ;
