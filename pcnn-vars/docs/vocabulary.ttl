var:smokingstatus a skos:Concept ;
  skos:inScheme : ;
  skos:prefLabel "Do you smoke?"@en ;
  skos:altLabel "smokingstatus" ;
  skos:notation "smokingstatus" ;
  skos:definition "Self-reported current smoking behaviour, including former smoking, occasional use, daily tobacco use by amount, and exclusive e-cigarette or vape use."@en ;
  skos:scopeNote "Theme: demographics / lifestyle. Instrument: none. Datatype: coded. Value set: vs:smokingstatus-6. Same topic as LOINC 72166-2; PCNN uses a 6-level list including vapes."@en ;
  skos:closeMatch <http://loinc.org/72166-2> .

var:paidjob a skos:Concept ;
